---
/* A label that trails the pointer over anything with `data-cursor`. Fine pointers only. */
---

<div class="cursor" data-cursor-dot aria-hidden="true"><span>View</span></div>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    pointer-events: none;
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .cursor {
      display: block;
    }
  }

  .cursor span {
    position: absolute;
    display: grid;
    place-items: center;
    width: 6.5rem;
    height: 6.5rem;
    margin: -3.25rem 0 0 -3.25rem;
    border-radius: 999px;
    background: var(--signal);
    color: #0d0d0c;
    font-weight: 600;
    font-size: 0.95rem;
    transform: scale(0);
    transition: transform 0.5s var(--ease-out-expo);
  }

  .cursor[data-active] span {
    transform: scale(1);
  }
</style>
